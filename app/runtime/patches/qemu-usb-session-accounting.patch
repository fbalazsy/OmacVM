+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Property-only exact allow-set validator sharing the native protected parser.
+ * Only an internal consumed ticket enables native_open admission. */
+/* Service matching omits present, unregistered registry entries (including
+ * user clients). Only a complete checked IOService-plane registry walk can
+ * witness immutable old-ID absence. One bounded pass covers all three IDs. */
+bool usb_host_coex_ids_gone(uint64_t root, uint64_t guard, uint64_t native)
+{
+    io_iterator_t it = 0;
+    if (!root) { return false; }
+    kern_return_t kr = IORegistryCreateIterator(kIOMainPortDefault,
+        kIOServicePlane, kIORegistryIterateRecursively, &it);
+    if (kr != KERN_SUCCESS || !it) {
+        if (it) { IOObjectRelease(it); }
+        return false;
+    }
+    unsigned budget = 262144;
+    bool complete = true, found = false;
+    io_object_t entry;
+    while ((entry = IOIteratorNext(it))) {
+        uint64_t id = 0;
+        complete = budget &&
+            IORegistryEntryGetRegistryEntryID(entry, &id) == KERN_SUCCESS && id;
+        if (complete) {
+            --budget;
+            found |= id == root || (guard && id == guard) || (native && id == native);
+        }
+        IOObjectRelease(entry);
+        if (!complete) { break; }
+    }
+    complete = complete && IOIteratorIsValid(it);
+    IOObjectRelease(it);
+    return complete && !found;
+}
+static bool coex_property_number(io_registry_entry_t e, CFStringRef key, uint64_t *n)
+{
+    CFTypeRef v = IORegistryEntryCreateCFProperty(e, key, kCFAllocatorDefault, 0);
+    bool ok = native_unsigned(v, n);
+    if (v) { CFRelease(v); }
+    return ok;
+}
+static bool coex_property_string(io_registry_entry_t e, CFStringRef key, const char *wanted)
+{
+    CFTypeRef v = IORegistryEntryCreateCFProperty(e, key, kCFAllocatorDefault, 0);
+    g_autofree char *s = native_string(v);
+    bool ok = s && !strcmp(s, wanted);
+    if (v) { CFRelease(v); }
+    return ok;
+}
+static bool coex_measure_snapshot(QDict *target, int pid, uint64_t cache,
+    uint64_t guard, int guard_pid, uint64_t native, bool discover,
+    bool pending, CoexMeasurement *out)
+{
+    g_autofree HostHIDState *s = g_new0(HostHIDState, 1);
+    g_autofree char *hash = NULL;
+    CoexMeasurement m = {0};
+    CoexTree tree = {.m = &m, .cache = cache, .guard = guard,
+        .guard_pid = guard_pid, .native = native, .discover = discover};
+    uint64_t page, usage, n;
+    uint32_t application = 0;
+    unsigned budget = 64, counts[3] = {0};
+    io_service_t root = 0, hid = 0;
+    CFTypeRef desc = NULL;
+    bool ok = false;
+    /* The handler has already validated canonical decimal strings. */
+    m.root = g_ascii_strtoull(qdict_get_str(target, "root-id"), NULL, 10);
+    m.interface = g_ascii_strtoull(qdict_get_str(target, "interface-id"), NULL, 10);
+    m.hid = g_ascii_strtoull(qdict_get_str(target, "hid-id"), NULL, 10);
+    m.pid = pid;
+    s->vendorid = qdict_get_int(target, "vendor-id");
+    s->productid = qdict_get_int(target, "product-id");
+    root = IOServiceGetMatchingService(kIOMainPortDefault, IORegistryEntryIDMatching(m.root));
+    hid = IOServiceGetMatchingService(kIOMainPortDefault, IORegistryEntryIDMatching(m.hid));
+    if (!root || !hid ||
+        IORegistryEntryGetRegistryEntryID(root, &n) != KERN_SUCCESS || n != m.root ||
+        IORegistryEntryGetRegistryEntryID(hid, &n) != KERN_SUCCESS || n != m.hid ||
+        !native_root(s, root) ||
+        !coex_property_number(root, CFSTR("sessionID"), &m.session) || !m.session ||
+        !coex_property_string(root, CFSTR("USB Serial Number"), qdict_get_str(target, "serial-utf8")) ||
+        !native_metadata(hid, true, &page, &usage) ||
+        !coex_property_string(hid, CFSTR(kIOHIDTransportKey), "USB") ||
+        !coex_property_string(hid, CFSTR(kIOHIDSerialNumberKey), qdict_get_str(target, "serial-utf8")) ||
+        !coex_property_number(hid, CFSTR(kIOHIDVendorIDKey), &n) || n != s->vendorid ||
+        !coex_property_number(hid, CFSTR(kIOHIDProductIDKey), &n) || n != s->productid) { goto out; }
+    desc = IORegistryEntryCreateCFProperty(hid, CFSTR(kIOHIDReportDescriptorKey), kCFAllocatorDefault, 0);
+    if (!desc || CFGetTypeID(desc) != CFDataGetTypeID() ||
+        CFDataGetLength(desc) <= 0 || CFDataGetLength(desc) > sizeof(s->report_desc) ||
+        CFDataGetLength(desc) > sizeof(m.descriptor)) { goto out; }
+    s->report_desc_len = CFDataGetLength(desc);
+    memcpy(s->report_desc, CFDataGetBytePtr(desc), s->report_desc_len);
+    if (!host_hid_parse(s, &application) || application != ((page << 16) | usage)) { goto out; }
+    hash = g_compute_checksum_for_data(G_CHECKSUM_SHA256, s->report_desc, s->report_desc_len);
+    if (strcmp(hash, qdict_get_str(target, "descriptor-sha256"))) { goto out; }
+    if (pending) {
+        /* A root guard may legitimately be created between prepare and commit.
+         * There is no native permission in this phase. Verify the old exact
+         * cache object/creator/parent, not a class/PID-wide child exception. */
+        /* User clients need not be registered IOService objects. IDMatching
+         * cannot find them; enumerate this exact root's children instead. */
+        io_iterator_t it = 0;
+        kern_return_t kr = IORegistryEntryGetChildIterator(root, kIOServicePlane, &it);
+        bool exact = cache && kr == KERN_SUCCESS && it;
+        io_object_t client;
+        while (exact && (client = IOIteratorNext(it))) {
+            io_name_t cls;
+            io_registry_entry_t parent = 0;
+            exact = budget &&
+                IORegistryEntryGetRegistryEntryID(client, &n) == KERN_SUCCESS && n;
+            if (exact) { --budget; }
+            if (exact && n == cache) {
+                exact = IOObjectGetClass(client, cls) == KERN_SUCCESS &&
+                    !strcmp(cls, "AppleUSBHostDeviceUserClient") &&
+                    coex_client(client, &tree, false) && m.cache == cache &&
+                    IORegistryEntryGetParentEntry(client, kIOServicePlane, &parent) == KERN_SUCCESS &&
+                    parent && IORegistryEntryGetRegistryEntryID(parent, &n) == KERN_SUCCESS && n == m.root;
+            }
+            if (parent) { IOObjectRelease(parent); }
+            IOObjectRelease(client);
+        }
+        exact = exact && IOIteratorIsValid(it) && m.cache == cache;
+        if (it) { IOObjectRelease(it); }
+        if (!exact) { goto out; }
+    } else if (!native_tree(root, m.hid, 0, 0, &budget, counts, page, usage, &tree) ||
+        counts[0] != 1 || counts[1] != 1 || !m.cache ||
+        (cache && m.cache != cache) || m.guard != guard ||
+        (discover ? !m.native : m.native != native)) { goto out; }
+    m.descriptor_len = s->report_desc_len;
+    memcpy(m.descriptor, s->report_desc, m.descriptor_len);
+    *out = m;
+    ok = true;
+out:
+    if (desc) { CFRelease(desc); }
+    if (hid) { IOObjectRelease(hid); }
+    if (root) { IOObjectRelease(root); }
+    return ok;
+}
+
+bool usb_host_coex_measure_clients(QDict *target, int pid, uint64_t cache,
+    uint64_t guard, int guard_pid, uint64_t native, bool discover, CoexMeasurement *out)
+{
+    return coex_measure_snapshot(target, pid, cache, guard, guard_pid, native,
+                                 discover, false, out);
+}
+bool usb_host_coex_measure_pending(QDict *target, int pid, uint64_t cache,
+                                     CoexMeasurement *out)
+{
+    return coex_measure_snapshot(target, pid, cache, 0, 0, 0, false, true, out);
+}
+bool usb_host_coex_measure(QDict *target, int pid, CoexMeasurement *out)
+{
+    return usb_host_coex_measure_clients(target, pid, 0, 0, 0, 0, false, out);
+}
