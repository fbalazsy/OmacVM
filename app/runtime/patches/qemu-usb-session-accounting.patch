+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include "qemu/osdep.h"
+#include <libusb.h>
+#include <pthread.h>
+#include "host-coexistence.h"
+
+/* One producer, owned by host-libusb.c. Never hold this lock across USB APIs.
+ * Retain tombstones until process exit: pointer/port reuse cannot thaw a session.
+ * The bound fails closed rather than allowing unaccounted opens.
+ */
+struct USBHostSession {
+    libusb_device *dev;
+    uint64_t id, epoch;
+    unsigned handles, transfers, callbacks;
+    bool frozen, uncertain, retained;
+    USBHostSession *next;
+};
+static pthread_mutex_t session_lock = PTHREAD_MUTEX_INITIALIZER;
+static USBHostSession *sessions;
+static unsigned session_count;
+static uint64_t next_epoch;
+static bool accounting_failed;
+typedef struct SessionTransfer {
+    const void *transfer;
+    USBHostSession *session;
+    struct SessionTransfer *next;
+} SessionTransfer;
+static SessionTransfer *transfers;
+
+/* Only never-leased, clean, idle ordinary heavy references can disappear.
+ * Frozen/uncertain/epoch-bearing tombstones never regain authority by pointer
+ * reuse. Heavy public refs are released outside our mutex. */
+static libusb_device *session_reclaim_idle(USBHostSession *s)
+{
+    if (!s || s->epoch || s->frozen || s->uncertain || s->handles ||
+        s->transfers || s->callbacks || accounting_failed || !s->retained) { return NULL; }
+    /* Keep the bounded tiny identity tombstone, not an owning public ref.
+     * A conflicting pointer for an already published session must still poison
+     * it. The stored non-owning address is compared only, never dereferenced. */
+    s->retained = false;
+    return s->dev;
+}
+
+bool usb_host_session_submit(USBHostSession *s, const void *transfer)
+{
+    SessionTransfer *t;
+    bool ok = false;
+    pthread_mutex_lock(&session_lock);
+    if (!s || !s->handles || s->frozen || s->uncertain || accounting_failed || !transfer) {
+        goto out;
+    }
+    for (t = transfers; t; t = t->next) {
+        if (t->transfer == transfer) {
+            s->uncertain = true;
+            goto out;
+        }
+    }
+    t = g_new0(SessionTransfer, 1);
+    t->session = s;
+    t->transfer = transfer;
+    t->next = transfers;
+    transfers = t;
+    s->transfers++;
+    ok = true;
+out:
+    pthread_mutex_unlock(&session_lock);
+    return ok;
+}
+
+void usb_host_session_complete(const void *transfer)
+{
+    SessionTransfer **p, *t;
+    pthread_mutex_lock(&session_lock);
+    for (p = &transfers; (t = *p); p = &t->next) {
+        if (t->transfer == transfer) {
+            assert(t->session->transfers);
+            t->session->transfers--;
+            *p = t->next;
+            g_free(t);
+            pthread_mutex_unlock(&session_lock);
+            return;
+        }
+    }
+    accounting_failed = true;
+    pthread_mutex_unlock(&session_lock);
+}
+
+/* Move a submitted token to dispatch ownership before entering guest code.
+ * The pointer can be resubmitted by that code; the old dispatch still pins the
+ * generation until callback_end, even after ordinary close and free_transfer. */
+USBHostSession *usb_host_session_callback_begin(const void *transfer)
+{
+    SessionTransfer **p, *t;
+    USBHostSession *s = NULL;
+    pthread_mutex_lock(&session_lock);
+    for (p = &transfers; (t = *p); p = &t->next) {
+        if (t->transfer == transfer) {
+            s = t->session;
+            assert(s->transfers);
+            s->transfers--;
+            s->callbacks++;
+            *p = t->next;
+            g_free(t);
+            break;
+        }
+    }
+    if (!s) {
+        accounting_failed = true;
+    }
+    pthread_mutex_unlock(&session_lock);
+    return s;
+}
+
+void usb_host_session_callback_end(USBHostSession *s)
+{
+    libusb_device *released = NULL;
+    pthread_mutex_lock(&session_lock);
+    if (s && s->callbacks) {
+        s->callbacks--;
+        released = session_reclaim_idle(s);
+    } else {
+        accounting_failed = true;
+    }
+    pthread_mutex_unlock(&session_lock);
+    if (released) { libusb_unref_device(released); }
+}
+
+void usb_host_session_uncertain(USBHostSession *s)
+{
+    pthread_mutex_lock(&session_lock);
+    if (s) {
+        s->uncertain = true;
+    }
+    pthread_mutex_unlock(&session_lock);
+}
+
+/* An existing handle pins native admission through all synchronous operations
+ * and checked cleanup. Only destructive reset needs to refuse freezing too. */
+bool usb_host_session_mutable(USBHostSession *s)
+{
+    bool ok;
+    pthread_mutex_lock(&session_lock);
+    ok = s && s->handles && !s->frozen && !s->uncertain && !accounting_failed;
+    pthread_mutex_unlock(&session_lock);
+    return ok;
+}
+static USBHostSession *session_find(uint64_t id)
+{
+    USBHostSession *s;
+    for (s = sessions; s; s = s->next) {
+        if (s->id == id) {
+            return s;
+        }
+    }
+    return NULL;
+}
+
+/* Public ref/getter are not device I/O; take the ref outside our mutex. */
+static USBHostSession *session_get(libusb_device *dev, uint64_t id, bool *created)
+{
+    USBHostSession *s = session_find(id);
+    if (!s && id && session_count < 4096) {
+        s = g_new0(USBHostSession, 1);
+        s->dev = dev;
+        s->retained = true;
+        s->id = id;
+        s->next = sessions;
+        sessions = s;
+        session_count++;
+        *created = true;
+    }
+    /* A reclaimed lost-generation tombstone can never reacquire a device. */
+    if (s && !s->dev && s->frozen) { return NULL; }
+    if (s && s->dev != dev) {
+        s->uncertain = true;
+        return NULL;
+    }
+    if (s && !s->retained) {
+        s->retained = true;
+        *created = true; /* Adopt caller's already-acquired public reference. */
+    }
+    return s;
+}
+
+USBHostSession *usb_host_session_acquire(libusb_device *dev)
+{
+    USBHostSession *s;
+    uint64_t id = libusb_get_session_data(dev);
+    bool created = false;
+    libusb_ref_device(dev);
+    pthread_mutex_lock(&session_lock);
+    s = session_get(dev, id, &created);
+    if (s && !s->frozen && !s->uncertain && !accounting_failed) {
+        s->handles++;
+    } else {
+        s = NULL;
+    }
+    pthread_mutex_unlock(&session_lock);
+    if (!created) {
+        libusb_unref_device(dev);
+    }
+    return s;
+}
+
+void usb_host_session_release(USBHostSession **session)
+{
+    libusb_device *released = NULL;
+    pthread_mutex_lock(&session_lock);
+    if (*session) {
+        assert((*session)->handles);
+        (*session)->handles--;
+        released = session_reclaim_idle(*session);
+        *session = NULL;
+    }
+    pthread_mutex_unlock(&session_lock);
+    if (released) { libusb_unref_device(released); }
+}
+
+bool usb_host_session_freeze(libusb_device *dev, uint64_t *epoch)
+{
+    USBHostSession *s;
+    bool ok = false;
+    bool created = false;
+    uint64_t id = libusb_get_session_data(dev);
+    libusb_ref_device(dev);
+    pthread_mutex_lock(&session_lock);
+    s = session_get(dev, id, &created);
+    if (s && !s->frozen && next_epoch != UINT64_MAX) {
+        s->epoch = ++next_epoch;
+        s->frozen = true;
+        *epoch = s->epoch;
+        ok = true;
+    }
+    pthread_mutex_unlock(&session_lock);
+    if (!created) {
+        libusb_unref_device(dev);
+    }
+    return ok;
+}
+
+bool usb_host_session_drained(uint64_t id, uint64_t epoch)
+{
+    bool ok;
+    pthread_mutex_lock(&session_lock);
+    USBHostSession *s = session_find(id);
+    ok = s && s->frozen && s->epoch == epoch && !s->handles &&
+         !s->transfers && !s->callbacks && !s->uncertain && !accounting_failed;
+    pthread_mutex_unlock(&session_lock);
+    return ok;
+}
+
