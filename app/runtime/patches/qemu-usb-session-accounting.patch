+
+static bool coex_keys(QDict *d, const char *keys)
+{
+    g_auto(GStrv) names = g_strsplit(keys, ",", -1);
+    unsigned n = 0;
+    if (!d) { return false; }
+    for (; names[n]; n++) {
+        if (!qdict_haskey(d, names[n])) { return false; }
+    }
+    return qdict_size(d) == n;
+}
+static bool coex_u64(QDict *d, const char *key, uint64_t *out, bool zero)
+{
+    const char *s = d ? qdict_get_try_str(d, key) : NULL;
+    uint64_t n = 0;
+    if (!s || !*s || (s[0] == '0' && s[1])) { return false; }
+    for (const char *p = s; *p; p++) {
+        if (*p < '0' || *p > '9' || n > (UINT64_MAX - (*p - '0')) / 10) { return false; }
+        n = n * 10 + (*p - '0');
+    }
+    *out = n;
+    return zero || n;
+}
+static void coex_put(QDict *d, const char *key, uint64_t n)
+{
+    g_autofree char *v = g_strdup_printf("%" PRIu64, n);
+    qdict_put_str(d, key, v);
+}
+static bool coex_hex(const char *s, size_t n)
+{
+    return s && strlen(s) == n && strspn(s, "0123456789abcdef") == n;
+}
+static bool coex_int(QDict *d, const char *key, int64_t max, int64_t *n)
+{
+    QNum *v = d ? qobject_to(QNum, qdict_get(d, key)) : NULL;
+    return v && v->kind != QNUM_DOUBLE && qnum_get_try_int(v, n) && *n > 0 && *n <= max;
+}
+static bool coex_task_valid(QDict *d)
+{
+    uint64_t sec, usec;
+    int64_t pid;
+    return coex_keys(d, "pid,start-sec,start-usec") &&
+        coex_int(d, "pid", INT_MAX, &pid) &&
+        coex_u64(d, "start-sec", &sec, true) &&
+        coex_u64(d, "start-usec", &usec, true) && usec <= 999999;
+}
+static bool coex_owner_valid(QDict *d)
+{
+    return coex_keys(d, "launch,task") &&
+        coex_hex(qdict_get_try_str(d, "launch"), 32) &&
+        coex_task_valid(qdict_get_qdict(d, "task"));
+}
+static bool coex_target_valid(QDict *d)
+{
+    uint64_t n;
+    int64_t v;
+    const char *s;
+    if (!coex_keys(d, "root-id,interface-id,hid-id,vendor-id,product-id,serial-utf8,descriptor-sha256")) { return false; }
+    s = qdict_get_try_str(d, "serial-utf8");
+    return coex_u64(d, "root-id", &n, false) &&
+        coex_u64(d, "interface-id", &n, false) && coex_u64(d, "hid-id", &n, false) &&
+        coex_int(d, "vendor-id", 65535, &v) && coex_int(d, "product-id", 65535, &v) &&
+        s && *s && strlen(s) <= 256 && g_utf8_validate(s, -1, NULL) &&
+        coex_hex(qdict_get_try_str(d, "descriptor-sha256"), 64);
+}
+static QDict *coex_read_task(int pid)
+{
+    struct proc_bsdinfo info;
+    QDict *d;
+    if (proc_pidinfo(pid, PROC_PIDTBSDINFO, 0, &info, sizeof(info)) != sizeof(info) ||
+        info.pbi_status == SZOMB) { return NULL; }
+    d = qdict_new();
+    qdict_put_int(d, "pid", pid);
+    coex_put(d, "start-sec", info.pbi_start_tvsec);
+    coex_put(d, "start-usec", info.pbi_start_tvusec);
+    return d;
+}
+static bool coex_published_valid(QDict *d)
+{
+    uint64_t n;
+    return coex_keys(d, "target,session,cache-client-id,qemu-task") &&
+        coex_target_valid(qdict_get_qdict(d, "target")) &&
+        coex_task_valid(qdict_get_qdict(d, "qemu-task")) &&
+        coex_u64(d, "session", &n, false) && coex_u64(d, "cache-client-id", &n, false);
+}
+static bool coex_measure_equal(const CoexMeasurement *a, const CoexMeasurement *b)
+{
+    return a->root == b->root && a->interface == b->interface && a->hid == b->hid &&
+        a->session == b->session && a->cache == b->cache && a->pid == b->pid &&
+        a->descriptor_len == b->descriptor_len && a->descriptor_len <= sizeof(a->descriptor) &&
+        !memcmp(a->descriptor, b->descriptor, a->descriptor_len);
+}
+static bool coex_parent_matches(QDict *task)
+{
+    uint64_t sec, usec;
+    return coex_task_valid(task) && qdict_get_int(task, "pid") == coex_parent_pid &&
+        coex_u64(task, "start-sec", &sec, true) && sec == coex_parent_sec &&
+        coex_u64(task, "start-usec", &usec, true) && usec == coex_parent_usec;
+}
+static bool coex_alive(void)
+{
+    QDict *task = coex_read_task(coex_parent_pid);
+    bool ok = task && coex_parent_matches(task);
+    qobject_unref(task);
+    return ok;
+}
+static bool coex_active(void)
+{
+    return coex_state && (!strcmp(coex_state, "freezing") || !strcmp(coex_state, "guard-pending") || !strcmp(coex_state, "native"));
+}
+/* No native ticket has ever existed in this epoch. A canonical cleanup handoff
+ * plus real ordinary drain therefore proves native-neverstarted. An admitted
+ * ticket, including failed Create, always needs its actual close completion. */
+static void coex_neverstarted_ack(void)
+{
+    pthread_mutex_lock(&session_lock);
+    USBHostSession *s = session_find(coex_measured.session);
+    if (coex_state && !strcmp(coex_state, "revoking") &&
+        coex_cleanup_recorded && !coex_ticket && !coex_native && s &&
+        s->frozen && s->epoch == coex_epoch && !s->handles && !s->transfers &&
+        !s->callbacks && !s->uncertain && !accounting_failed) {
+        coex_state = "guard-release";
+    }
+    pthread_mutex_unlock(&session_lock);
+}
+static void coex_revoke(void)
+{
+    pthread_mutex_lock(&session_lock);
+    if (coex_state && strcmp(coex_state, "retired") && strcmp(coex_state, "uncertain")) {
+        coex_state = coex_ticket && coex_ticket->closed ? "guard-release" : "revoking";
+    }
+    pthread_mutex_unlock(&session_lock);
+    if (coex_ticket) { usb_host_coex_native_revoke(coex_ticket); }
+    coex_neverstarted_ack();
+}
+static bool coex_generation(void)
+{
+    bool ok;
+    pthread_mutex_lock(&session_lock);
+    USBHostSession *s = session_find(coex_measured.session);
+    ok = s && s->epoch == coex_epoch && s->frozen && !s->handles &&
+        !s->transfers && !s->callbacks && !s->uncertain && !accounting_failed;
+    pthread_mutex_unlock(&session_lock);
+    return ok;
+}
+static bool coex_public_generation(void)
+{
+    Error *err = NULL;
+    libusb_device *dev = usb_host_coex_published(coex_measured.session, &err);
+    pthread_mutex_lock(&session_lock);
+    USBHostSession *s = session_find(coex_measured.session);
+    bool ok = dev && s && s->dev == dev && s->epoch == coex_epoch && s->frozen &&
+        !s->handles && !s->transfers && !s->callbacks && !s->uncertain && !accounting_failed;
+    pthread_mutex_unlock(&session_lock);
+    if (dev) { libusb_unref_device(dev); }
+    error_free(err);
+    return ok;
+}
+static bool coex_tree(uint64_t guard, uint64_t native, bool discover,
+                      CoexMeasurement *m)
+{
+    return usb_host_coex_measure_clients(qdict_get_qdict(coex_published, "target"),
+        getpid(), coex_measured.cache, guard, coex_parent_pid, native, discover, m) &&
+        coex_measure_equal(m, &coex_measured) && m->guard == guard &&
+        (discover ? m->native != 0 : m->native == native);
+}
+static bool coex_ticket_current(CoexNativeTicket *t)
+{
+    return t && t == coex_ticket && t->key.epoch == coex_epoch &&
+        t->key.session == coex_measured.session && t->key.root == coex_measured.root &&
+        !strcmp(t->key.launch, coex_launch);
+}
+CoexNativeTicket *usb_host_coex_native_reserve(const CoexLeaseKey *key,
+    const CoexPublished *published, uint64_t guard_id,
+    const CoexTask *guard_task, Error **errp)
+{
+    CoexMeasurement m = {0};
+    if (!key || !published || !guard_task || coex_ticket || !guard_id ||
+        key->epoch != coex_epoch || key->session != coex_measured.session ||
+        key->root != coex_measured.root || strcmp(key->launch, coex_launch) ||
+        !coex_measure_equal(&published->measured, &coex_measured) ||
+        guard_task->pid != coex_parent_pid || guard_task->sec != coex_parent_sec ||
+        guard_task->usec != coex_parent_usec || !coex_alive() ||
+        qemu_clock_get_ms(QEMU_CLOCK_REALTIME) >= coex_deadline ||
+        !coex_state || strcmp(coex_state, "guard-pending") ||
+        !coex_public_generation() || !coex_tree(guard_id, 0, false, &m)) {
+        error_setg(errp, "COEX_IDENTITY: native reservation rejected"); return NULL;
+    }
+    /* Recheck the epoch following the unlocked registry result. */
+    if (!coex_generation() || key->epoch != coex_epoch) {
+        error_setg(errp, "COEX_STALE: reservation changed"); return NULL;
+    }
+    pthread_mutex_lock(&session_lock);
+    coex_ticket = g_new0(CoexNativeTicket, 1);
+    coex_ticket->key = *key; coex_ticket->published = *published;
+    coex_ticket->guard_task = *guard_task; coex_ticket->guard = guard_id;
+    coex_guard = guard_id;
+    pthread_mutex_unlock(&session_lock);
+    return coex_ticket;
+}
+bool usb_host_coex_native_check(CoexNativeTicket *t, CoexNativeStage stage,
+                                 uint64_t native_client_id, Error **errp)
+{
+    CoexMeasurement m = {0};
+    if (!coex_ticket_current(t)) {
+        error_setg(errp, "COEX_STALE: native ticket belongs to another epoch"); return false;
+    }
+    bool order = t && ((stage == COEX_BEFORE_CREATE && !t->consumed) ||
+        (stage == COEX_AFTER_CREATE && t->consumed && t->stage == 1) ||
+        (stage == COEX_BEFORE_OPEN && t->stage == 2) ||
+        (stage == COEX_AFTER_OPEN && t->stage == 3) ||
+        (stage == COEX_SUBMIT && t->stage == 4));
+    if (!coex_ticket_current(t) || !order || t->revoked || t->closed ||
+        !coex_active() || !coex_alive() ||
+        qemu_clock_get_ms(QEMU_CLOCK_REALTIME) >= coex_deadline ||
+        !coex_public_generation() || (native_client_id && native_client_id != coex_native) ||
+        !coex_tree(coex_guard, coex_native, stage == COEX_AFTER_OPEN, &m) ||
+        !coex_ticket_current(t) || !coex_generation()) {
+        error_setg(errp, "COEX_POLICY: native stage/epoch/exact clients rejected");
+        coex_revoke(); return false;
+    }
+    pthread_mutex_lock(&session_lock);
+    if (stage == COEX_BEFORE_CREATE) { t->consumed = true; t->stage = 1; }
+    if (stage == COEX_AFTER_CREATE) { t->stage = 2; }
+    if (stage == COEX_AFTER_OPEN) { coex_native = t->native = m.native; t->stage = 4; }
+    if (stage == COEX_BEFORE_OPEN) { t->stage = 3; }
+    if (stage == COEX_SUBMIT) { t->started = true; }
+    pthread_mutex_unlock(&session_lock);
+    return true;
+}
+bool usb_host_coex_native_descriptor(CoexNativeTicket *t,
+                                      const uint8_t *data, size_t len)
+{
+    if (!coex_ticket_current(t)) { return false; }
+    const CoexMeasurement *m = &t->published.measured;
+    bool ok = !t->revoked && !t->closed && data && len == m->descriptor_len &&
+        len <= sizeof(m->descriptor) && !memcmp(data, m->descriptor, len);
+    if (!ok) { coex_revoke(); }
+    return ok;
+}
+void usb_host_coex_native_revoke(CoexNativeTicket *t)
+{
+    if (!coex_ticket_current(t) || t->revoked) { return; }
+    pthread_mutex_lock(&session_lock);
+    t->revoked = true;
+    if (!t->closed && strcmp(coex_state, "uncertain")) { coex_state = "revoking"; }
+    pthread_mutex_unlock(&session_lock);
+    usb_host_coex_native_stop(t); /* disables submits before scheduling close */
+}
+void usb_host_coex_native_closed(CoexNativeTicket *t, bool drained, bool closed)
+{
+    if (!coex_ticket_current(t) || !t->revoked || t->closed) { return; }
+    if (!drained || !closed) {
+        pthread_mutex_lock(&session_lock);
+        USBHostSession *s = session_find(t->key.session);
+        if (s && s->epoch == t->key.epoch) { s->uncertain = true; }
+        coex_state = "uncertain";
+        pthread_mutex_unlock(&session_lock);
+        return;
+    }
+    if (!coex_generation()) { return; }
+    pthread_mutex_lock(&session_lock);
+    t->closed = true;
+    t->disposal = COEX_DISPOSAL_CHECKED_CLOSE;
+    coex_state = "guard-release";
+    pthread_mutex_unlock(&session_lock);
+}
+/* Called by the cleanup worker only AFTER actual cancel + serial queue drain.
+ * All mutable coordinator/ledger state is accessed under session_lock. The
+ * immutable post-Open IDs are copied, then checked again after the bounded
+ * registry traversal. No QDict, public libusb or QMP call occurs under lock. */
+static bool coex_gone_eligible(CoexNativeTicket *t)
+{
+    if (!coex_ticket_current(t)) { return false; }
+    USBHostSession *s = t ? session_find(t->key.session) : NULL;
+    return coex_ticket_current(t) && t->revoked && t->consumed && t->stage == 4 &&
+        !t->closed && t->guard && t->native && t->key.root &&
+        t->key.root != t->guard && t->key.root != t->native && t->guard != t->native &&
+        t->guard == coex_guard && t->native == coex_native &&
+        t->published.measured.root == t->key.root &&
+        coex_measure_equal(&t->published.measured, &coex_measured) &&
+        t->guard_task.pid == coex_parent_pid && t->guard_task.sec == coex_parent_sec &&
+        t->guard_task.usec == coex_parent_usec && coex_cleanup_recorded &&
+        coex_state && !strcmp(coex_state, "revoking") && s && s->dev && s->retained &&
+        s->frozen && s->epoch == t->key.epoch && !s->handles && !s->transfers &&
+        !s->callbacks && !s->uncertain && !accounting_failed;
+}
+bool usb_host_coex_native_gone(CoexNativeTicket *t)
+{
+    CoexLeaseKey key = {0};
+    uint64_t guard = 0, native = 0;
+    pthread_mutex_lock(&session_lock);
+    bool ok = coex_gone_eligible(t);
+    if (ok) { key = t->key; guard = t->guard; native = t->native; }
+    pthread_mutex_unlock(&session_lock);
+    if (!ok || !usb_host_coex_ids_gone(key.root, guard, native)) { return false; }
+    pthread_mutex_lock(&session_lock);
+    ok = coex_gone_eligible(t) && t->key.epoch == key.epoch &&
+        t->key.session == key.session && t->key.root == key.root &&
+        !strcmp(t->key.launch, key.launch) && t->guard == guard && t->native == native;
+    pthread_mutex_unlock(&session_lock);
+    return ok;
+}
+bool usb_host_coex_native_gone_disposed(CoexNativeTicket *t)
+{
+    /* Worker has executed CFRelease and its post-release exact-ID proof. Recheck
+     * once more on the BQL completion; never reinterpret this as Close0. */
+    if (!usb_host_coex_native_gone(t)) {
+        usb_host_coex_native_closed(t, true, false);
+        return false;
+    }
+    pthread_mutex_lock(&session_lock);
+    bool ok = coex_gone_eligible(t);
+    if (ok) {
+        t->closed = true;
+        t->disposal = COEX_DISPOSAL_OLD_GENERATION_GONE;
+        coex_state = "guard-release";
+    }
+    pthread_mutex_unlock(&session_lock);
+    if (!ok) { usb_host_coex_native_closed(t, true, false); }
+    return ok;
+}
+static bool coex_recheck(void)
+{
+    CoexMeasurement m = {0};
+    libusb_device *dev;
+    Error *err = NULL;
+    bool ok;
+    if (!coex_alive() || qemu_clock_get_ms(QEMU_CLOCK_REALTIME) >= coex_deadline) { return false; }
+    if (!coex_ticket && !coex_cleanup_recorded) {
+        if (!usb_host_coex_measure_pending(qdict_get_qdict(coex_published, "target"),
+             getpid(), coex_measured.cache, &m) ||
+             !coex_measure_equal(&m, &coex_measured)) { return false; }
+    } else if (!coex_tree(coex_guard, coex_native, false, &m)) { return false; }
+    dev = usb_host_coex_published(m.session, &err);
+    pthread_mutex_lock(&session_lock);
+    USBHostSession *s = session_find(m.session);
+    ok = dev && s && s->dev == dev && s->epoch == coex_epoch && !s->uncertain && !accounting_failed;
+    pthread_mutex_unlock(&session_lock);
+    if (dev) { libusb_unref_device(dev); }
+    error_free(err);
+    return ok;
+}
+static void coex_watchdog(void *opaque)
+{
+    if (coex_active() && !coex_recheck()) { coex_revoke(); }
+    if (coex_active()) { timer_mod(coex_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 250); }
+}
+static QDict *coex_status(void)
+{
+    QDict *d = qdict_new();
+    coex_neverstarted_ack();
+    pthread_mutex_lock(&session_lock);
+    USBHostSession *s = session_find(coex_measured.session);
+    bool poison = !s || s->uncertain || accounting_failed;
+    if (poison && coex_active()) { coex_state = "uncertain"; }
+    pthread_mutex_unlock(&session_lock);
+    if (poison && coex_ticket) { usb_host_coex_native_revoke(coex_ticket); }
+    pthread_mutex_lock(&session_lock);
+    s = session_find(coex_measured.session);
+    bool uncertain = !s || s->uncertain || accounting_failed;
+    if (coex_active() && uncertain) { coex_state = "uncertain"; }
+    if (coex_active() && strcmp(coex_state, "native") && s && !s->handles && !s->transfers && !s->callbacks) { coex_state = "guard-pending"; }
+    qdict_put(d, "lease", qobject_ref(coex_lease));
+    qdict_put(d, "published", qobject_ref(coex_published));
+    coex_put(d, "sequence", coex_sequence);
+    qdict_put_str(d, "state", coex_state);
+    coex_put(d, "guard-client-id", coex_guard);
+    coex_put(d, "native-client-id", coex_native);
+    coex_put(d, "handles", s ? s->handles : 0);
+    coex_put(d, "transfers", s ? s->transfers : 0);
+    coex_put(d, "callbacks", s ? s->callbacks : 0);
+    qdict_put_bool(d, "uncertain", uncertain);
+    pthread_mutex_unlock(&session_lock);
+    return d;
+}
+static bool coex_lease_valid(QDict *d)
+{
+    uint64_t n;
+    return coex_keys(d, "qemu-launch,launcher,lease-epoch") &&
+        coex_hex(qdict_get_try_str(d, "qemu-launch"), 32) &&
+        coex_owner_valid(qdict_get_qdict(d, "launcher")) &&
+        coex_u64(d, "lease-epoch", &n, false);
+}
+static bool coex_call(QDict *call, Error **errp)
+{
+    uint64_t seq;
+    if (!coex_keys(call, "lease,sequence") ||
+        !coex_lease_valid(qdict_get_qdict(call, "lease")) ||
+        !coex_u64(call, "sequence", &seq, false)) {
+        error_setg(errp, "COEX_SCHEMA: invalid Call"); return false;
+    }
+    if (!coex_lease || !qobject_is_equal(QOBJECT(qdict_get_qdict(call, "lease")), QOBJECT(coex_lease))) {
+        error_setg(errp, "COEX_STALE: unknown lease"); return false;
+    }
+    if (coex_sequence == UINT64_MAX || seq != coex_sequence + 1) {
+        coex_revoke(); error_setg(errp, "COEX_STALE: replay or sequence gap revokes lease"); return false;
+    }
+    if (coex_active() && (!coex_alive() || qemu_clock_get_ms(QEMU_CLOCK_REALTIME) >= coex_deadline)) { coex_revoke(); }
+    return true;
+}
+static void coex_prepare(QDict *args, QObject **ret, Error **errp)
+{
+    QDict *owner = qdict_get_qdict(args, "launcher");
+    QDict *target = qdict_get_qdict(args, "target");
+    CoexMeasurement first = {0}, second = {0};
+    uint64_t seq, epoch;
+    libusb_device *dev;
+    if (!coex_keys(args, "launcher,sequence,target") || !coex_owner_valid(owner) ||
+        !coex_target_valid(target) || !coex_u64(args, "sequence", &seq, false) || seq != 1) {
+        error_setg(errp, "COEX_SCHEMA: invalid prepare"); return;
+    }
+    if (!coex_parent_matches(qdict_get_qdict(owner, "task")) || !coex_alive() ||
+        !coex_task || (coex_owner && !qobject_is_equal(QOBJECT(owner), QOBJECT(coex_owner)))) {
+        error_setg(errp, "COEX_IDENTITY: launcher is not startup parent"); return;
+    }
+    if (coex_state && !strcmp(coex_state, "retired")) {
+        pthread_mutex_lock(&session_lock);
+        qobject_unref(coex_lease); coex_lease = NULL;
+        qobject_unref(coex_published); coex_published = NULL;
+        coex_ticket = NULL; coex_guard = coex_native = 0;
+        coex_cleanup_recorded = false;
+        coex_state = NULL;
+        pthread_mutex_unlock(&session_lock);
+    }
+    if (coex_retained >= 4096) { error_setg(errp, "COEX_BUSY: retained lease bound"); return; }
+    if (coex_lease) {
+        if (qobject_is_equal(QOBJECT(target), qdict_get(coex_published, "target"))) { coex_revoke(); }
+        error_setg(errp, "COEX_BUSY: generation retained; prepare replay revokes same target"); return;
+    }
+    /* Init singleton before registry measurement: discovery may create cache. */
+    if (!usb_host_coex_init(errp)) { return; }
+    if (!usb_host_coex_measure(target, getpid(), &first)) {
+        error_setg(errp, "COEX_POLICY: exact root/cache/protected identity rejected"); return;
+    }
+    dev = usb_host_coex_published(first.session, errp);
+    if (!dev) { return; }
+    if (!usb_host_coex_measure(target, getpid(), &second) || !coex_measure_equal(&first, &second)) {
+        libusb_unref_device(dev); error_setg(errp, "COEX_IDENTITY: publication changed generation"); return;
+    }
+    if (!usb_host_session_freeze(dev, &epoch)) {
+        libusb_unref_device(dev); error_setg(errp, "COEX_BUSY: session already frozen"); return;
+    }
+    libusb_unref_device(dev);
+    pthread_mutex_lock(&session_lock);
+    if (!coex_owner) {
+        coex_owner = qdict_clone_shallow(owner);
+        qdict_put(coex_owner, "task", qdict_clone_shallow(qdict_get_qdict(owner, "task")));
+    }
+    coex_measured = first;
+    coex_epoch = epoch;
+    coex_sequence = 1;
+    coex_state = "freezing";
+    coex_deadline = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 5000;
+    coex_lease = qdict_new();
+    qdict_put_str(coex_lease, "qemu-launch", coex_launch);
+    qdict_put(coex_lease, "launcher", qobject_ref(coex_owner));
+    coex_put(coex_lease, "lease-epoch", epoch);
+    coex_published = qdict_new();
+    qdict_put(coex_published, "target", qdict_clone_shallow(target));
+    coex_put(coex_published, "session", first.session);
+    coex_put(coex_published, "cache-client-id", first.cache);
+    qdict_put(coex_published, "qemu-task", qobject_ref(coex_task));
+    pthread_mutex_unlock(&session_lock);
+    if (!coex_timer) { coex_timer = timer_new_ms(QEMU_CLOCK_REALTIME, coex_watchdog, NULL); }
+    timer_mod(coex_timer, qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 250);
+    if (!coex_recheck()) { coex_revoke(); }
+    *ret = QOBJECT(coex_status());
+}
+static void coex_query(QDict *args, QObject **ret, Error **errp)
+{
+    bool exact = coex_keys(args, "lease");
+    bool lookup = coex_keys(args, "launcher,target");
+    if ((!exact && !lookup) ||
+        (exact && !coex_lease_valid(qdict_get_qdict(args, "lease"))) ||
+        (lookup && (!coex_owner_valid(qdict_get_qdict(args, "launcher")) ||
+                    !coex_target_valid(qdict_get_qdict(args, "target"))))) {
+        error_setg(errp, "COEX_SCHEMA: status requires Lease OR launcher+target"); return;
+    }
+    for (CoexTombstone *t = coex_retired; t; t = t->next) {
+        if ((exact && qobject_is_equal(qdict_get(args, "lease"), qdict_get(t->status, "lease"))) ||
+            (lookup && !coex_lease && qobject_is_equal(qdict_get(args, "launcher"), QOBJECT(coex_owner)) &&
+             qobject_is_equal(qdict_get(args, "target"), qdict_get(qdict_get_qdict(t->status, "published"), "target")))) {
+            *ret = QOBJECT(qdict_clone_shallow(t->status)); return;
+        }
+    }
+    if (!coex_lease ||
+        (exact && !qobject_is_equal(QOBJECT(qdict_get_qdict(args, "lease")), QOBJECT(coex_lease))) ||
+        (lookup && (!qobject_is_equal(QOBJECT(qdict_get_qdict(args, "launcher")), QOBJECT(coex_owner)) ||
+                    !qobject_is_equal(QOBJECT(qdict_get_qdict(args, "target")), qdict_get(coex_published, "target"))))) {
+        error_setg(errp, "COEX_STALE: no exact retained receipt"); return;
+    }
+    if (coex_active() && !coex_recheck()) { coex_revoke(); }
+    *ret = QOBJECT(coex_status());
+}
+static void coex_renew(QDict *args, QObject **ret, Error **errp)
+{
+    uint64_t guard;
+    QDict *call = qdict_get_qdict(args, "call");
+    if (!coex_keys(args, "call,published,guard-client-id,guard-task") ||
+        !coex_published_valid(qdict_get_qdict(args, "published")) ||
+        !coex_task_valid(qdict_get_qdict(args, "guard-task")) ||
+        !coex_u64(args, "guard-client-id", &guard, true)) {
+        error_setg(errp, "COEX_SCHEMA: invalid renew"); return;
+    }
+    if (!coex_call(call, errp)) { return; }
+    if (!qobject_is_equal(qdict_get(args, "published"), QOBJECT(coex_published)) || guard != coex_guard ||
+        !qobject_is_equal(qdict_get(args, "guard-task"), qdict_get(coex_owner, "task"))) {
+        coex_revoke(); error_setg(errp, "COEX_IDENTITY: immutable receipt mismatch"); return;
+    }
+    if (coex_active() && !coex_recheck()) { coex_revoke(); }
+    if (!coex_active()) { error_setg(errp, "COEX_UNCERTAIN: revoked generation cannot renew"); return; }
+    pthread_mutex_lock(&session_lock);
+    coex_u64(call, "sequence", &coex_sequence, false);
+    coex_deadline = qemu_clock_get_ms(QEMU_CLOCK_REALTIME) + 5000;
+    pthread_mutex_unlock(&session_lock);
+    *ret = QOBJECT(coex_status());
+}
+static void coex_cancel(QDict *args, QObject **ret, Error **errp)
+{
+    const char *reason = qdict_get_try_str(args, "reason");
+    bool cleanup = coex_keys(args, "call,reason,published,guard-client-id,guard-task");
+    uint64_t guard = 0;
+    if ((!coex_keys(args, "call,reason") && !cleanup) || !reason ||
+        (cleanup && (!coex_published_valid(qdict_get_qdict(args, "published")) ||
+                     !coex_task_valid(qdict_get_qdict(args, "guard-task")) ||
+                     !coex_u64(args, "guard-client-id", &guard, true))) ||
+        (strcmp(reason, "user") && strcmp(reason, "requesting-close") && strcmp(reason, "guard-loss") &&
+         strcmp(reason, "policy-change") && strcmp(reason, "attach-failed") && strcmp(reason, "shutdown"))) {
+        error_setg(errp, "COEX_SCHEMA: invalid revoke"); return;
+    }
+    if (!coex_call(qdict_get_qdict(args, "call"), errp)) { return; }
+    if (cleanup) {
+        if (!qobject_is_equal(qdict_get(args, "published"), QOBJECT(coex_published)) ||
+            !qobject_is_equal(qdict_get(args, "guard-task"), qdict_get(coex_owner, "task")) ||
+            (coex_cleanup_recorded && guard != coex_guard) ||
+            !strcmp(coex_state, "retired")) {
+            coex_revoke(); error_setg(errp, "COEX_IDENTITY: cleanup receipt mismatch"); return;
+        }
+        pthread_mutex_lock(&session_lock);
+        coex_guard = guard;
+        coex_cleanup_recorded = true;
+        pthread_mutex_unlock(&session_lock);
+    }
+    coex_revoke();
+    pthread_mutex_lock(&session_lock);
+    coex_u64(qdict_get_qdict(args, "call"), "sequence", &coex_sequence, false);
+    pthread_mutex_unlock(&session_lock);
+    *ret = QOBJECT(coex_status());
+}
+static void coex_commit(QDict *args, QObject **ret, Error **errp)
+{
+    uint64_t guard;
+    const char *open = qdict_get_try_str(args, "guard-open");
+    const char *id = qdict_get_try_str(args, "device-id");
+    QDict *call = qdict_get_qdict(args, "call");
+    if (!coex_keys(args, "call,published,guard-client-id,guard-task,guard-open,device-id") ||
+        !coex_published_valid(qdict_get_qdict(args, "published")) ||
+        !coex_task_valid(qdict_get_qdict(args, "guard-task")) ||
+        !coex_u64(args, "guard-client-id", &guard, false) ||
+        !open || strcmp(open, "nonseizing-success") || !id || !*id || strlen(id) > 64 ||
+        strspn(id, "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_.-") != strlen(id)) {
+        error_setg(errp, "COEX_SCHEMA: invalid commit"); return;
+    }
+    if (!coex_call(call, errp)) { return; }
+    if (!qobject_is_equal(qdict_get(args, "published"), QOBJECT(coex_published)) ||
+        !qobject_is_equal(qdict_get(args, "guard-task"), qdict_get(coex_owner, "task"))) {
+        coex_revoke(); error_setg(errp, "COEX_IDENTITY: commit receipt mismatch"); return;
+    }
+    /* Retain the launcher's exact acquired ID even when reservation fails
+     * before adoption. It is a cleanup receipt, never native admission proof. */
+    if ((coex_cleanup_recorded && coex_guard != guard) ||
+        !strcmp(coex_state, "retired") || !strcmp(coex_state, "guard-release")) {
+        coex_revoke(); error_setg(errp, "COEX_IDENTITY: guard ID cannot be replaced"); return;
+    }
+    pthread_mutex_lock(&session_lock);
+    coex_guard = guard;
+    coex_cleanup_recorded = true;
+    pthread_mutex_unlock(&session_lock);
+    CoexLeaseKey key = {.epoch = coex_epoch, .session = coex_measured.session, .root = coex_measured.root};
+    memcpy(key.launch, coex_launch, sizeof(key.launch));
+    CoexPublished published = {.measured = coex_measured};
+    CoexTask task = {.pid = coex_parent_pid, .sec = coex_parent_sec, .usec = coex_parent_usec};
+    CoexNativeTicket *t = usb_host_coex_native_reserve(&key, &published, guard, &task, errp);
+    if (!t) { coex_revoke(); return; }
+    pthread_mutex_lock(&session_lock);
+    coex_u64(call, "sequence", &coex_sequence, false);
+    pthread_mutex_unlock(&session_lock);
+    if (!usb_host_coex_native_attach(t, qdict_get_qdict(coex_published, "target"), id, errp)) {
+        coex_revoke(); return;
+    }
+    if (!usb_host_coex_native_check(t, COEX_SUBMIT, coex_native, errp)) { return; }
+    pthread_mutex_lock(&session_lock);
+    coex_state = "native";
+    pthread_mutex_unlock(&session_lock);
+    *ret = QOBJECT(coex_status());
+}
+/* session_lock held. A launcher disposal assertion cannot create a native ACK.
+ * Only the exact post-Open ticket already drained by either native disposition
+ * is eligible; all three immutable IDs must remain available for our scan. */
+static bool coex_guard_gone_eligible(void)
+{
+    CoexNativeTicket *t = coex_ticket;
+    return coex_ticket_current(t) && t->closed && t->revoked && t->consumed &&
+        t->stage == 4 && coex_cleanup_recorded &&
+        (t->disposal == COEX_DISPOSAL_CHECKED_CLOSE ||
+         t->disposal == COEX_DISPOSAL_OLD_GENERATION_GONE) &&
+        t->key.root && t->guard && t->native &&
+        t->key.root != t->guard && t->key.root != t->native && t->guard != t->native &&
+        t->guard == coex_guard && t->native == coex_native &&
+        coex_measure_equal(&t->published.measured, &coex_measured) &&
+        t->guard_task.pid == coex_parent_pid && t->guard_task.sec == coex_parent_sec &&
+        t->guard_task.usec == coex_parent_usec &&
+        coex_state && !strcmp(coex_state, "guard-release");
+}
+static void coex_release(QDict *args, QObject **ret, Error **errp)
+{
+    uint64_t guard;
+    QDict *call = qdict_get_qdict(args, "call");
+    QBool *closed = qobject_to(QBool, qdict_get(args, "guard-closed"));
+    QBool *disposed = qobject_to(QBool, qdict_get(args, "guard-disposed-gone"));
+    bool guard_gone = coex_keys(args, "call,guard-client-id,guard-closed,guard-disposed-gone") &&
+        closed && !qbool_get_bool(closed) && disposed && qbool_get_bool(disposed);
+    bool checked_close = coex_keys(args, "call,guard-client-id,guard-closed") &&
+        closed && qbool_get_bool(closed);
+    if ((!checked_close && !guard_gone) ||
+        !coex_u64(args, "guard-client-id", &guard, !guard_gone)) {
+        error_setg(errp, "COEX_SCHEMA: invalid release"); return;
+    }
+    if (!coex_call(call, errp)) { return; }
+    /* A guard acquired locally before a failed commit was never adopted.
+     * Accept its exact ID only after an independent cache-only exact-root
+     * witness AND proof that no native ticket/Create was ever admitted. */
+    if (!guard_gone) { coex_neverstarted_ack(); }
+    pthread_mutex_lock(&session_lock);
+    bool guard_ready = !guard_gone || coex_guard_gone_eligible();
+    pthread_mutex_unlock(&session_lock);
+    bool never = !coex_ticket && coex_cleanup_recorded && !coex_native;
+    if (!guard_ready || guard != coex_guard || strcmp(coex_state, "guard-release") ||
+        (!never && (!coex_ticket || !coex_ticket->closed || !guard))) {
+        error_setg(errp, "COEX_UNCERTAIN: native closure/guard receipt required"); return;
+    }
+    CoexMeasurement m = {0};
+    bool gone = usb_host_coex_ids_gone(coex_measured.root, coex_guard, coex_native);
+    bool gone_only = guard_gone ||
+        (coex_ticket && coex_ticket->disposal == COEX_DISPOSAL_OLD_GENERATION_GONE);
+    if (!coex_generation() || (gone_only && !gone) ||
+        (!gone && !coex_tree(0, 0, false, &m)) || !coex_generation()) {
+        error_setg(errp, "COEX_UNCERTAIN: exact root not clean after guard close"); return;
+    }
+    libusb_device *dev = gone ? NULL : usb_host_coex_published(m.session, errp);
+    if (!gone && !dev) { return; }
+    libusb_device *retained = NULL;
+    pthread_mutex_lock(&session_lock);
+    USBHostSession *s = session_find(coex_measured.session);
+    bool clean = s && (!guard_gone || coex_guard_gone_eligible()) &&
+        (gone || s->dev == dev) && s->epoch == coex_epoch && s->frozen &&
+        !s->handles && !s->transfers && !s->callbacks && !s->uncertain && !accounting_failed;
+    if (clean) {
+        /* Lost generation stays permanently frozen, with its immutable session
+         * tombstone. Drop only its heavy libusb reference, never thaw by port. */
+        if (gone) { retained = s->retained ? s->dev : NULL; s->dev = NULL; s->retained = false; }
+        else { s->frozen = false; }
+        coex_state = "retired";
+        coex_u64(call, "sequence", &coex_sequence, false);
+    }
+    pthread_mutex_unlock(&session_lock);
+    if (dev) { libusb_unref_device(dev); }
+    if (retained) { libusb_unref_device(retained); }
+    if (!clean) { error_setg(errp, "COEX_STALE: release generation changed"); return; }
+    QDict *status = coex_status();
+    CoexTombstone *t = g_new0(CoexTombstone, 1);
+    t->status = qdict_clone_shallow(status); t->next = coex_retired;
+    pthread_mutex_lock(&session_lock);
+    coex_retired = t; coex_retained++;
+    pthread_mutex_unlock(&session_lock);
+    *ret = QOBJECT(status);
+}
+static void coex_register(void)
+{
+    QDict *parent;
+    g_autofree char *uuid = g_uuid_string_random();
+    unsigned j = 0;
+    coex_parent_pid = getppid();
+    parent = coex_read_task(coex_parent_pid);
+    if (parent && coex_parent_pid != getpid()) {
+        coex_u64(parent, "start-sec", &coex_parent_sec, true);
+        coex_u64(parent, "start-usec", &coex_parent_usec, true);
+        coex_task = coex_read_task(getpid());
+    }
+    qobject_unref(parent);
+    for (unsigned i = 0; uuid[i]; i++) { if (uuid[i] != '-') { coex_launch[j++] = uuid[i]; } }
+    qmp_register_command(&qmp_commands, "x-omacvm-usb-coexistence-prepare", coex_prepare, 0, 0);
+    qmp_register_command(&qmp_commands, "x-omacvm-usb-coexistence-status", coex_query, 0, 0);
+    qmp_register_command(&qmp_commands, "x-omacvm-usb-coexistence-renew", coex_renew, 0, 0);
+    qmp_register_command(&qmp_commands, "x-omacvm-usb-coexistence-revoke", coex_cancel, 0, 0);
+    qmp_register_command(&qmp_commands, "x-omacvm-usb-coexistence-commit", coex_commit, 0, 0);
+    qmp_register_command(&qmp_commands, "x-omacvm-usb-coexistence-release", coex_release, 0, 0);
+}
+type_init(coex_register)
