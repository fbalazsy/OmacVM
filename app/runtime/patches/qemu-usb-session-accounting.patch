+bool usb_host_coex_init(Error **errp)
+{
+    if (usb_host_init() != 0) {
+        error_setg(errp, "COEX_UNCERTAIN: singleton init failed");
+        return false;
+    }
+    return true;
+}
+libusb_device *usb_host_coex_published(uint64_t session, Error **errp)
+{
+    libusb_device **list = NULL, *found = NULL;
+    ssize_t n;
+    /* Called by non-OOB QMP with BQL: same singleton as ordinary/HMP. */
+    if (usb_host_init() != 0 || (n = libusb_get_device_list(ctx, &list)) < 0) {
+        error_setg(errp, "COEX_UNCERTAIN: singleton publication failed");
+        return NULL;
+    }
+    for (ssize_t i = 0; i < n; i++) {
+        if (libusb_get_session_data(list[i]) == session) {
+            if (found) {
+                libusb_unref_device(found);
+                found = NULL;
+                break;
+            }
+            found = libusb_ref_device(list[i]);
+        }
+    }
+    libusb_free_device_list(list, 1);
+    if (!found) {
+        error_setg(errp, "COEX_IDENTITY: absent or ambiguous published session");
+    }
+    return found;
+}
+#endif
