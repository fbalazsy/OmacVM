+/* Sole internal bridge. The reference is set before realize; it cannot be
+ * supplied through device_add or QOM. All entrypoints here run under BQL. */
+static HostHIDState *coex_device;
+bool usb_host_coex_native_attach(CoexNativeTicket *ticket, QDict *target,
+                                  const char *id, Error **errp)
+{
+    if (coex_device) { error_setg(errp, "COEX_BUSY: native object retained"); return false; }
+    DeviceState *dev = qdev_new(TYPE_HOST_HID);
+    HostHIDState *s = HOST_HID(dev);
+    coex_device = s; s->ticket = ticket; s->coex_opening = true;
+    s->registry_id = g_ascii_strtoull(qdict_get_str(target, "hid-id"), NULL, 10);
+    s->vendorid = qdict_get_int(target, "vendor-id");
+    s->productid = qdict_get_int(target, "product-id");
+    USB_DEVICE(s)->serial = g_strdup(qdict_get_str(target, "serial-utf8"));
+    /* qdev's id registration detects duplicates, no caller ticket property. */
+    BusState *bus = qdev_find_default_bus(DEVICE_GET_CLASS(dev), errp);
+    bool ok = bus && qdev_set_id(dev, g_strdup(id), errp) && qdev_realize(dev, bus, errp);
+    s->coex_opening = false;
+    if (!ok) {
+        usb_host_coex_native_revoke(ticket);
+        usb_host_coex_native_stop(ticket);
+    }
+    return ok;
+}
+void usb_host_coex_native_stop(CoexNativeTicket *ticket)
+{
+    HostHIDState *s = coex_device;
+    if (!s || s->ticket != ticket) { return; }
+    qemu_mutex_lock(&s->lock);
+    s->live = false; /* disable_new_submits, before worker dispatch */
+    qemu_mutex_unlock(&s->lock);
+    if (s->coex_opening || s->closing) { return; }
+    if (qdev_is_realized(DEVICE(s))) { qdev_unrealize(DEVICE(s)); }
+    else { host_hid_unrealize(USB_DEVICE(s)); }
+}
+static void usb_host_coex_native_forget(HostHIDState *s)
+{
+    if (coex_device == s) {
+        coex_device = NULL;
+        object_unparent(OBJECT(s));
+        object_unref(OBJECT(s)); /* bridge qdev_new reference */
+    }
+}
