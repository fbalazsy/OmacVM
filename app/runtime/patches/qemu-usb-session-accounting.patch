+/* All synchronous handle operations are inside its one reservation. Unknown
+ * mutation/cleanup results poison that generation; close is never a cure. */
+static int usb_host_checked(USBHostDevice *s, int rc)
+{
+#ifdef CONFIG_DARWIN
+    if (rc < 0) { usb_host_session_uncertain(s->session); }
+#endif
+    return rc;
+}
+static int usb_host_submit_transfer(USBHostDevice *s,
+                                    struct libusb_transfer *transfer)
+{
+    int rc;
+    if (!s->dh || s->closing || s->stopping) {
+        return LIBUSB_ERROR_NO_DEVICE;
+    }
+#ifdef CONFIG_DARWIN
+    if (!usb_host_session_submit(s->session, transfer)) {
+        return LIBUSB_ERROR_BUSY;
+    }
+#endif
+    rc = libusb_submit_transfer(transfer);
+#ifdef CONFIG_DARWIN
+    if (rc != 0) {
+        usb_host_session_complete(transfer);
+    }
+#endif
+    return rc;
+}
 
