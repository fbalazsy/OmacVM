+    const char *mode=getenv("REVIEW_CASE");g_assert_nonnull(mode);scope_init();
+    bool allow=!strcmp(mode,"parent-snapshot") || !strcmp(mode,"generic-base") || !strcmp(mode,"false-built-in") || !strcmp(mode,"unrelated-name");
+    if(!strcmp(mode,"generic-base"))scope_nodes[1].cls="IOHIDDevice";
+    if(!strcmp(mode,"false-built-in"))for(unsigned i=1;i<=4;i++)scope_num(i,CFSTR("Built-In"),0);
+    unsigned n=1;const char *dash=strrchr(mode,'-');if(dash && dash[1]>='1' && dash[1]<='5')n=dash[1]-'0';
+    if(g_str_has_prefix(mode,"built-in-"))scope_num(n,CFSTR("Built-In"),1);
+    if(g_str_has_prefix(mode,"boolean-internal-"))CFDictionarySetValue(scope_nodes[n].props,CFSTR("Built-In"),kCFBooleanTrue);
+    if(g_str_has_prefix(mode,"malformed-internal-"))CFDictionarySetValue(scope_nodes[n].props,CFSTR("Built-In"),CFSTR("false"));
+    if(g_str_has_prefix(mode,"standard-page-")){scope_usage(n);scope_num(n,CFSTR("PrimaryUsagePage"),1);}
+    if(g_str_has_prefix(mode,"malformed-page-")){scope_usage(n);CFDictionarySetValue(scope_nodes[n].props,CFSTR("PrimaryUsagePage"),kCFBooleanTrue);}
+    if(g_str_has_prefix(mode,"missing-page-"))CFDictionaryRemoveValue(scope_nodes[n].props,CFSTR("PrimaryUsagePage"));
+    if(g_str_has_prefix(mode,"missing-pairs-"))CFDictionaryRemoveValue(scope_nodes[n].props,CFSTR("DeviceUsagePairs"));
+    if(g_str_has_prefix(mode,"empty-pairs-")){CFArrayRef a=CFArrayCreate(NULL,NULL,0,&kCFTypeArrayCallBacks);CFDictionarySetValue(scope_nodes[n].props,CFSTR("DeviceUsagePairs"),a);CFRelease(a);}
