+        usb_register_port(&bus, &ports[i], NULL, i, &pops, USB_SPEED_MASK_FULL);
+    }
+    USBDevice *d = make_device(&bus);
+    uint8_t data[60], reply[60] = {0};
+    memset(data, 0x5a, sizeof(data));
+    int n, r;
