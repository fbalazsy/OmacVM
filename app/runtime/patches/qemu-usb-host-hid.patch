+/* Reviewer safety fence for inherited QEMU block_file-posix disk discovery.
+ * Diskless tests must not call these. Production HID calls are separately
+ * replaced by review-native-shim.h before compiling the complete source. */
+#include <IOKit/IOKitLib.h>
+#include <stdlib.h>
+#include <stdio.h>
+static void forbidden(void) __attribute__((noreturn));
+static void forbidden(void) { fputs("FORBIDDEN native block IORegistry call\n", stderr); abort(); }
+io_object_t IOIteratorNext(io_iterator_t iterator) { forbidden(); }
+kern_return_t IOObjectRelease(io_object_t object) { forbidden(); }
+CFTypeRef IORegistryEntryCreateCFProperty(io_registry_entry_t e, CFStringRef k, CFAllocatorRef a, IOOptionBits o) { forbidden(); }
+kern_return_t IOServiceGetMatchingServices(mach_port_t p, CFDictionaryRef d, io_iterator_t *i) { forbidden(); }
+CFMutableDictionaryRef IOServiceMatching(const char *n) { forbidden(); }
