+static void port_noop(USBPort *p) {}
+static void complete_noop(USBPort *p, USBPacket *packet) {}
+static USBPortOps pops = {.attach=port_noop,.detach=port_noop,.complete=complete_noop};
+static USBBusOps bops;
+static int packet(USBDevice *d, int pid, int ep, uint8_t *data, int n, int *actual)
+{
+    USBPacket p;
+    usb_packet_init(&p);
+    usb_packet_setup(&p,pid,usb_ep_get(d,pid,ep),0,1,false,false);
+    usb_packet_addbuf(&p,data,n);
+    usb_handle_packet(d,&p);
+    if (p.status == USB_RET_ASYNC) {
+        while (usb_packet_is_inflight(&p)) main_loop_wait(false);
+    }
+    int status=p.status;
+    *actual=p.actual_length;
+    usb_packet_cleanup(&p);
+    return status;
+}
+static int control(USBDevice *d,int req,int value,int index,uint8_t *data,int n,int *actual)
+{
+    uint8_t setup[8]={req>>8,req,value,value>>8,index,index>>8,n,n>>8};
+    int a, r=packet(d,USB_TOKEN_SETUP,0,setup,8,&a);
+    if(r) return r;
+    *actual=0;
+    while(*actual<n) {
+        int chunk=MIN(64,n-*actual), got;
+        r=packet(d,(req&0x8000)?USB_TOKEN_IN:USB_TOKEN_OUT,0,data+*actual,chunk,&got);
+        if(r) return r;
+        *actual+=got;
+        if(got<chunk) break;
+    }
+    return packet(d,(req&0x8000)?USB_TOKEN_OUT:USB_TOKEN_IN,0,NULL,0,&a);
+}
