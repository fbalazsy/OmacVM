+/* Review regressions: real USB core, exact production source, no native I/O. */
+#include "review-test-base.inc"
+
+static USBDevice *make_device(USBBus *bus)
+{
+    USBDevice *d = USB_DEVICE(qdev_new("usb-host-hid"));
+    qdev_prop_set_uint64(&d->qdev, "registry-id", 123);
+    qdev_prop_set_uint16(&d->qdev, "vendorid", 0xc251);
+    qdev_prop_set_uint16(&d->qdev, "productid", 0x1701);
+    qdev_prop_set_string(&d->qdev, "serial", "tFIXTUR0E123");
+    qdev_realize(&d->qdev, &bus->qbus, &error_abort);
+    usb_device_reset(d);
+    int n, r = control(d, 0x0009, 1, 0, NULL, 0, &n);
+    g_assert_cmpint(r, ==, 0);
+    return d;
+}
+static void start_packet(USBDevice *d, USBPacket *p, int pid, int ep,
+                         uint8_t *data, size_t len, uint64_t parameter)
+{
+    usb_packet_init(p);
+    usb_packet_setup(p, pid, usb_ep_get(d, pid, ep), 0, 99, false, false);
+    usb_packet_addbuf(p, data, len);
+    p->parameter = parameter;
+    usb_handle_packet(d, p);
+}
+static void finish_native(IOReturn status, CFIndex length)
+{
+    dispatch_sync(shim_queue, ^{
+        review_pending_cb(review_pending_ctx, status, review_pending_device,
+                          review_pending_type, review_pending_id,
+                          review_pending_data, length);
+    });
+    review_pending_cb = NULL;
+}
+static void wait_packet(USBPacket *p)
+{
+    while (usb_packet_is_inflight(p)) { main_loop_wait(false); }
+}
+int main(void)
+{
+    const char *mode = getenv("REVIEW_CASE");
+    g_assert_nonnull(mode);
+    const char *args[] = {"hid-regression", "-machine", "none", "-accel", "qtest",
+        "-nodefaults", "-no-user-config", "-display", "none", "-net", "none", "-S", NULL};
+    char *argv[13];
+    for (int i = 0; i < 13; i++) { argv[i] = g_strdup(args[i]); }
+    qemu_init(12, argv);
+    USBBus bus; USBPort ports[2];
+    DeviceState *host = qdev_new("usb-hub");
+    usb_bus_new(&bus, sizeof(bus), &bops, host);
